# Environment variables for BROKE AF
# Copy to .env and fill values before running

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_ENV=development

# Database (Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/brokeaf?schema=public

# NextAuth
NEXTAUTH_SECRET=change_me_to_a_secure_random_value

# OpenAI (server-side only)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: Email SMTP for magic links and notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example
SMTP_PASS=example

# App config
MAX_IMPORT_FILE_SIZE_MB=20
MAX_IMPORT_TRANSACTIONS=5000

# Sentry / Monitoring (optional)
#SENTRY_DSN=
