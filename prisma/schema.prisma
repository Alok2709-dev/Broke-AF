// Prisma schema for BROKE AF
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]
  subscriptions Subscription[]
  imports       Import[]
  preferences   UserPreferences?
  aiInsights    AIInsight[]
}

model Account {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  name        String
  type        AccountType
  currency    String    // ISO currency code
  balance     Decimal   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  transactions Transaction[]
}

enum AccountType {
  BANK
  CREDIT_CARD
  CASH
  UPI
  WALLET
  SAVINGS
}

model Transaction {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  account      Account?  @relation(fields: [accountId], references: [id])
  accountId    String?
  date         DateTime
  merchant     String?
  description  String?
  amount       Decimal
  currency     String
  direction    Direction
  category     Category? @relation(fields: [categoryId], references: [id])
  categoryId   String?
  subcategory  String?
  paymentMethod String?
  status       TransactionStatus @default(POSTED)
  reference    String?
  source       String?  // importer source
  confidence   Float?   // 0-1
  isDuplicate  Boolean  @default(false)
  isTransfer   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Direction {
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  POSTED
  FAILED
  CANCELLED
  REVERSED
}

model Category {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  userId    String?  // allow custom categories
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
}

model Budget {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  name         String
  amount       Decimal
  currency     String
  resetDay     Int      // day of month budget resets
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Goal {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  name         String
  targetAmount Decimal
  currentAmount Decimal @default(0)
  currency     String
  deadline     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  merchant     String
  amount       Decimal
  currency     String
  frequency    String
  nextCharge   DateTime?
  lastCharge   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Import {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  filename       String
  source         String?
  totalDetected  Int      @default(0)
  totalImported  Int      @default(0)
  status         ImportStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  transactions   ImportTransaction[]
}

enum ImportStatus {
  PENDING
  PROCESSING
  REVIEW
  IMPORTED
  FAILED
}

model ImportTransaction {
  id           String    @id @default(cuid())
  import       Import    @relation(fields: [importId], references: [id])
  importId     String
  date         DateTime
  merchant     String?
  description  String?
  amount       Decimal
  currency     String
  direction    Direction
  confidence   Float?
  raw          Json?
  createdAt    DateTime  @default(now())
}

model AIInsight {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  body      String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())
}

model UserPreferences {
  id              String  @id @default(cuid())
  user            User    @relation(fields: [userId], references: [id])
  userId          String  @unique
  currency        String  @default("INR")
  timezone        String? 
  theme           String? 
  lockdownActive  Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}
